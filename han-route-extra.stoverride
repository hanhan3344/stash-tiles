name: Han Route Tiles Extra
desc: >
  Optional extras: Cursor, Telegram, linux.do, Instagram, Steam, PayPal.

tiles:
  - name: Cursor-Han
    title: Cursor
    icon: https://cursor.com/apple-touch-icon.png
    collapsed: true
    url: https://cursor.com
  - name: Telegram-Han
    title: Telegram
